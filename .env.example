# Production site URL used for canonical links, Open Graph URLs, JSON-LD, and sitemap.xml.
# Set this in Vercel → Project Settings → Environment Variables (Production + Preview).
VITE_SITE_URL=https://your-domain.com

# Optional: Google Search Console ownership verification meta token
# Search Console → Settings → Ownership verification → HTML tag → paste the content= value only
VITE_GOOGLE_SITE_VERIFICATION=

# Optional: Bing Webmaster Tools verification meta token
VITE_BING_SITE_VERIFICATION=

# After deploy:
# 1. Set VITE_SITE_URL to your live domain and redeploy
# 2. Add verification tokens above, redeploy
# 3. In Google Search Console, add the property and submit https://YOUR-DOMAIN/sitemap.xml
# 4. In Bing Webmaster Tools, submit the same sitemap
